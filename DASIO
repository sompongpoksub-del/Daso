-- Valen Hub - สคริปต์แมพนี้
-- ใช้ Rayfield UI | เมนูภาษาไทย
-- ไม่มีโค้ดเสกปืน

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- Load Rayfield UI
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Valen Hub | สคริปต์แมพนี้",
    LoadingTitle = "กำลังโหลด...",
    LoadingSubtitle = "by Valen",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "ValenHubConfig",
        FileName = "Config"
    },
    Discord = {
        Enabled = false,
        Invite = "",
        RememberJoins = false
    },
    KeySystem = false
})

-- ========== แท็บ: ผู้เล่น ==========
local PlayerTab = Window:CreateTab("ผู้เล่น", "user")

local WalkSpeedSlider = PlayerTab:CreateSlider({
    Name = "ความเร็วการเดิน",
    Range = {16, 500},
    Increment = 1,
    Suffix = "",
    CurrentValue = 16,
    Flag = "WalkSpeed",
    Callback = function(Value)
        if Humanoid then
            Humanoid.WalkSpeed = Value
        end
    end
})

local JumpPowerSlider = PlayerTab:CreateSlider({
    Name = "พลังกระโดด",
    Range = {50, 500},
    Increment = 1,
    Suffix = "",
    CurrentValue = 50,
    Flag = "JumpPower",
    Callback = function(Value)
        if Humanoid then
            Humanoid.JumpPower = Value
        end
    end
})

local InfiniteJumpToggle = PlayerTab:CreateToggle({
    Name = "กระโดดกลางอากาศ",
    CurrentValue = false,
    Flag = "InfiniteJump",
    Callback = function(Value)
        _G.InfiniteJump = Value
    end
})

UserInputService.JumpRequest:Connect(function()
    if _G.InfiniteJump and Humanoid then
        Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

local NoclipToggle = PlayerTab:CreateToggle({
    Name = "ทะลุกำแพง (Noclip)",
    CurrentValue = false,
    Flag = "Noclip",
    Callback = function(Value)
        _G.Noclip = Value
    end
})

RunService.Stepped:Connect(function()
    if _G.Noclip and Character then
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

local FlyToggle = PlayerTab:CreateToggle({
    Name = "บิน",
    CurrentValue = false,
    Flag = "Fly",
    Callback = function(Value)
        _G.Fly = Value
        if Value then
            local BodyGyro = Instance.new("BodyGyro")
            local BodyVelocity = Instance.new("BodyVelocity")
            BodyGyro.P = 9e4
            BodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            BodyGyro.CFrame = HumanoidRootPart.CFrame
            BodyVelocity.Velocity = Vector3.new(0, 0, 0)
            BodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            BodyGyro.Parent = HumanoidRootPart
            BodyVelocity.Parent = HumanoidRootPart
            _G.FlyGyro = BodyGyro
            _G.FlyVelocity = BodyVelocity
        else
            if _G.FlyGyro then _G.FlyGyro:Destroy() end
            if _G.FlyVelocity then _G.FlyVelocity:Destroy() end
        end
    end
})

UserInputService.InputBegan:Connect(function(input)
    if _G.Fly and input.KeyCode == Enum.KeyCode.Space then
        _G.FlyVelocity.Velocity = Vector3.new(0, 50, 0)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if _G.Fly and input.KeyCode == Enum.KeyCode.Space then
        _G.FlyVelocity.Velocity = Vector3.new(0, 0, 0)
    end
end)

local GodModeToggle = PlayerTab:CreateToggle({
    Name = "อมตะ",
    CurrentValue = false,
    Flag = "GodMode",
    Callback = function(Value)
        _G.GodMode = Value
        if Value and Humanoid then
            Humanoid.MaxHealth = math.huge
            Humanoid.Health = math.huge
        end
    end
})

-- ========== แท็บ: ESP ==========
local ESPTab = Window:CreateTab("มองทะลุ", "eye")

local ESPToggle = ESPTab:CreateToggle({
    Name = "เปิด ESP ผู้เล่น",
    CurrentValue = false,
    Flag = "ESP",
    Callback = function(Value)
        _G.ESP = Value
        if Value then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESPHighlight"
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = player.Character

                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "ESPName"
                    billboard.Size = UDim2.new(0, 200, 0, 50)
                    billboard.StudsOffset = Vector3.new(0, 3, 0)
                    billboard.AlwaysOnTop = true
                    local textLabel = Instance.new("TextLabel")
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    textLabel.TextStrokeTransparency = 0
                    textLabel.Text = player.Name
                    textLabel.Parent = billboard
                    billboard.Parent = player.Character:FindFirstChild("Head") or player.Character
                end
            end
        else
            for _, player in pairs(Players:GetPlayers()) do
                if player.Character then
                    for _, obj in pairs(player.Character:GetDescendants()) do
                        if obj.Name == "ESPHighlight" or obj.Name == "ESPName" then
                            obj:Destroy()
                        end
                    end
                end
            end
        end
    end
})

local ItemESPToggle = ESPTab:CreateToggle({
    Name = "ESP ไอเทม",
    CurrentValue = false,
    Flag = "ItemESP",
    Callback = function(Value)
        _G.ItemESP = Value
        if Value then
            for _, item in pairs(Workspace:GetDescendants()) do
                if item:IsA("Tool") or item:IsA("Model") and item:FindFirstChild("Handle") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ItemESP"
                    highlight.FillColor = Color3.fromRGB(0, 255, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                    highlight.Parent = item
                end
            end
        else
            for _, item in pairs(Workspace:GetDescendants()) do
                for _, obj in pairs(item:GetDescendants()) do
                    if obj.Name == "ItemESP" then
                        obj:Destroy()
                    end
                end
            end
        end
    end
})

-- ========== แท็บ: วาร์ป ==========
local TeleportTab = Window:CreateTab("วาร์ป", "map-pin")

local function getPlayerList()
    local list = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(list, player.Name)
        end
    end
    return list
end

local PlayerDropdown = TeleportTab:CreateDropdown({
    Name = "วาร์ปไปหาผู้เล่น",
    Options = getPlayerList(),
    CurrentOption = "",
    Flag = "TeleportPlayer",
    Callback = function(Option)
        local target = Players:FindFirstChild(Option)
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
        end
    end
})

TeleportTab:CreateButton({
    Name = "รีเฟรชรายชื่อผู้เล่น",
    Callback = function()
        PlayerDropdown:Refresh(getPlayerList(), true)
    end
})

TeleportTab:CreateButton({
    Name = "วาร์ปไป Spawn",
    Callback = function()
        if Workspace:FindFirstChild("SpawnLocation") then
            HumanoidRootPart.CFrame = Workspace.SpawnLocation.CFrame + Vector3.new(0, 5, 0)
        end
    end
})

-- ========== แท็บ: มุมมอง ==========
local VisualTab = Window:CreateTab("มุมมอง", "sun")

local FullBrightToggle = VisualTab:CreateToggle({
    Name = "สว่างทั้งแมพ",
    CurrentValue = false,
    Flag = "FullBright",
    Callback = function(Value)
        if Value then
            _G.OldBrightness = Lighting.Brightness
            _G.OldClockTime = Lighting.ClockTime
            _G.OldFogEnd = Lighting.FogEnd
            _G.OldGlobalShadows = Lighting.GlobalShadows
            Lighting.Brightness = 10
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = false
        else
            Lighting.Brightness = _G.OldBrightness or 1
            Lighting.ClockTime = _G.OldClockTime or 12
            Lighting.FogEnd = _G.OldFogEnd or 1000
            Lighting.GlobalShadows = _G.OldGlobalShadows or true
        end
    end
})

local NoFogToggle = VisualTab:CreateToggle({
    Name = "ปิดหมอก",
    CurrentValue = false,
    Flag = "NoFog",
    Callback = function(Value)
        if Value then
            Lighting.FogEnd = 100000
        else
            Lighting.FogEnd = 1000
        end
    end
})

