-- ========== แท็บ: อาวุธ ==========
local WeaponTab = Window:CreateTab("อาวุธ", "sword")

WeaponTab:CreateButton({
    Name = "รีโหลดอาวุธ",
    Callback = function()
        local tool = Character:FindFirstChildOfClass("Tool")
        if tool then
            local reloadEvent = tool:FindFirstChild("Reload") or tool:FindFirstChild("ReloadEvent")
            if reloadEvent and reloadEvent:IsA("RemoteEvent") then
                reloadEvent:FireServer()
            end
        end
    end
})

WeaponTab:CreateButton({
    Name = "เต็มแม็กกาซีน",
    Callback = function()
        local tool = Character:FindFirstChildOfClass("Tool")
        if tool then
            local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("CurrentAmmo")
            local maxAmmo = tool:FindFirstChild("MaxAmmo") or tool:FindFirstChild("AmmoMax")
            if ammo and maxAmmo then
                ammo.Value = maxAmmo.Value
            end
        end
    end
})

local NoRecoilToggle = WeaponTab:CreateToggle({
    Name = "ไม่ดีด (No Recoil)",
    CurrentValue = false,
    Flag = "NoRecoil",
    Callback = function(Value)
        _G.NoRecoil = Value
        local recoilEvent = ReplicatedStorage:FindFirstChild("recoilViewmodel")
        if recoilEvent and recoilEvent:IsA("BindableEvent") then
            if Value then
                _G.OldRecoil = recoilEvent.Event:Connect(function() end)
            else
                if _G.OldRecoil then
                    _G.OldRecoil:Disconnect()
                end
            end
        end
    end
})

local RapidFireToggle = WeaponTab:CreateToggle({
    Name = "ยิงเร็ว",
    CurrentValue = false,
    Flag = "RapidFire",
    Callback = function(Value)
        _G.RapidFire = Value
        local tool = Character:FindFirstChildOfClass("Tool")
        if tool then
            local fireRate = tool:FindFirstChild("FireRate") or tool:FindFirstChild("RPM")
            if fireRate then
                if Value then
                    _G.OldFireRate = fireRate.Value
                    fireRate.Value = 0.01
                else
                    fireRate.Value = _G.OldFireRate or fireRate.Value
                end
            end
        end
    end
})

-- ========== แท็บ: ผู้เล่นอื่น ==========
local OthersTab = Window:CreateTab("ผู้เล่นอื่น", "users")

local KillAllToggle = OthersTab:CreateToggle({
    Name = "ฆ่าทุกคน (Melee)",
    CurrentValue = false,
    Flag = "KillAll",
    Callback = function(Value)
        _G.KillAll = Value
        if Value then
            while _G.KillAll do
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") then
                        local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                        if targetHRP then
                            HumanoidRootPart.CFrame = targetHRP.CFrame
                            local tool = Character:FindFirstChildOfClass("Tool")
                            if tool then
                                local attackEvent = tool:FindFirstChild("Attack") or tool:FindFirstChild("Melee")
                                if attackEvent and attackEvent:IsA("RemoteEvent") then
                                    attackEvent:FireServer(player.Character)
                                end
                            end
                        end
                    end
                end
                task.wait(0.5)
            end
        end
    end
})

local BringAllToggle = OthersTab:CreateToggle({
    Name = "ดึงทุกคนมาหา",
    CurrentValue = false,
    Flag = "BringAll",
    Callback = function(Value)
        _G.BringAll = Value
        if Value then
            while _G.BringAll do
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        player.Character.HumanoidRootPart.CFrame = HumanoidRootPart.CFrame + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))
                    end
                end
                task.wait(0.1)
            end
        end
    end
})

OthersTab:CreateButton({
    Name = "ดึงผู้เล่นทั้งหมด",
    Callback = function()
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                player.Character.HumanoidRootPart.CFrame = HumanoidRootPart.CFrame + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))
            end
        end
    end
})

-- ========== แท็บ: อื่นๆ ==========
local MiscTab = Window:CreateTab("อื่นๆ", "settings")

MiscTab:CreateButton({
    Name = "รีเซ็ตตัวละคร",
    Callback = function()
        Humanoid.Health = 0
    end
})

MiscTab:CreateButton({
    Name = "เติมเลือด",
    Callback = function()
        if Humanoid then
            Humanoid.Health = Humanoid.MaxHealth
        end
    end
})

local AntiAFKToggle = MiscTab:CreateToggle({
    Name = "ป้องกัน AFK",
    CurrentValue = false,
    Flag = "AntiAFK",
    Callback = function(Value)
        _G.AntiAFK = Value
        if Value then
            local vu = game:GetService("VirtualUser")
            LocalPlayer.Idled:Connect(function()
                if _G.AntiAFK then
                    vu:Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                    task.wait(1)
                    vu:Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                end
            end)
        end
    end
})

MiscTab:CreateButton({
    Name = "ลบเอฟเฟกต์หน้าจอ",
    Callback = function()
        for _, effect in pairs(Lighting:GetChildren()) do
            if effect:IsA("BlurEffect") or effect:IsA("ColorCorrectionEffect") or effect:IsA("BloomEffect") then
                effect:Destroy()
            end
        end
        for _, gui in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if gui:IsA("BlurEffect") or gui.Name:lower():find("damage") or gui.Name:lower():find("hit") then
                gui:Destroy()
            end
        end
    end
})

-- อัปเดต Character เมื่อ Respawn
LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    Humanoid = newChar:WaitForChild("Humanoid")
